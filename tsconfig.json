{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@config": [
        "./src/config.js"
      ],
      "@data": [
        "./src/data/index.js"
      ],
      "@data/*": [
        "./src/data/*"
      ],
      "@definitions": [
        "./src/definitions/index.js"
      ],
      "@definitions/*": [
        "./src/definitions/*"
      ],
      "@engine": [
        "./src/engine/index.js"
      ],
      "@engine/*": [
        "./src/engine/*"
      ],
      "@media": [
        "./src/media/index.js"
      ],
      "@media/*": [
        "./src/media/*"
      ],
      "@simulation": [
        "./src/simulation/index.js"
      ],
      "@simulation/*": [
        "./src/simulation/*"
      ],
      "@state": [
        "./src/state/index.js"
      ],
      "@state/*": [
        "./src/state/*"
      ],
      "@atoms": [
        "./src/ui/atoms/index.js"
      ],
      "@atoms/*": [
        "./src/ui/atoms/*"
      ],
      "@molecules": [
        "./src/ui/molecules/index.js"
      ],
      "@molecules/*": [
        "./src/ui/molecules/*"
      ],
      "@organisms": [
        "./src/ui/organisms/index.js"
      ],
      "@organisms/*": [
        "./src/ui/organisms/*"
      ],
      "@ui": [
        "./src/ui/index.js"
      ],
      "@ui/*": [
        "./src/ui/*"
      ],
      "@utils": [
        "./src/utils/index.js"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "$src/*": [
        "./src/*"
      ]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "ESNext",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "noEmit": true
  },
  "exclude": [
    "**/.agents/**",
    "**/.git/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/archive/**",
    "**/tmp/**",
    "test-results/**",
    ".secrets",
    "**/*.lock"
  ],
  "include": [
    "src/**/*.d.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "types.d.ts"
  ]
}
