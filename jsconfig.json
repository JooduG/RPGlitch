{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@config": [
        "./src/config.js"
      ],
      "@data/*": [
        "./src/data/*"
      ],
      "@definitions/*": [
        "./src/definitions/*"
      ],
      "@engine/*": [
        "./src/engine/*"
      ],
      "@media/*": [
        "./src/media/*"
      ],
      "@primitives/*": [
        "./src/ui/primitives/*"
      ],
      "@ui/*": [
        "./src/ui/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "$src/*": [
        "./src/*"
      ]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "ESNext"
  },
  "exclude": [
    "**/.agents/**",
    "**/.git/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/archive/**",
    "**/tmp/**",
    "test-results/**",
    ".secrets",
    "**/*.lock"
  ],
  "include": [
    "src/**/*.d.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "types.d.ts"
  ]
}
