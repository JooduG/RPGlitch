{
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "allowJs": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "checkJs": false,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@primitives": [
        "src/ui/primitives/index.js"
      ],
      "@primitives/*": [
        "src/ui/primitives/*"
      ],
      "@utils": [
        "src/utils/index.js"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
      "@config": [
        "src/config.js"
      ],
      "@data": [
        "src/data/index.js"
      ],
      "@data/*": [
        "src/data/*"
      ],
      "@engine": [
        "src/engine/index.js"
      ],
      "@engine/*": [
        "src/engine/*"
      ],
      "@media": [
        "src/media/index.js"
      ],
      "@media/*": [
        "src/media/*"
      ],
      "@ui": [
        "src/ui/index.js"
      ],
      "@ui/*": [
        "src/ui/*"
      ]
    },
    "strict": true,
    "target": "esnext",
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ]
  },
  "exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/archive/**",
    "**/tmp/**",
    "tmp/**/*",
    "test-results/**",
    ".secrets",
    "**/*.lock"
  ],
  "include": [
    "src/**/*",
    "types.d.ts",
    "tmp/harness"
  ]
}
