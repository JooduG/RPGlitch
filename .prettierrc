{
  "useTabs": false,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 160,
  "singleAttributePerLine": false,
  "bracketSameLine": true,
  "experimentalTernaries": true,
  "objectWrap": "collapse",
  "proseWrap": "never",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-sort-package-json", "prettier-plugin-markdown-html", "prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./src/media/design.css",
  "overrides": [{ "files": "*.svelte", "options": { "parser": "svelte" } }]
}
