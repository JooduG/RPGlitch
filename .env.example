# .env.example - Template for RPGlitch Engine
# Copy this to .env and fill in the values.

# Smithery
SMITHERY_API_KEY=your-smithery-api-key
SMITHERY_PROFILE=your-smithery-profile

# Developer Database
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
PINECONE_API_KEY=your-pinecone-api-key

# Perchance (Deployment)
PERCHANCE_USERNAME=your-perchance-username
PERCHANCE_KEY=your-perchance-key
PERCHANCE_URL=https://perchance.org/your-project#edit
PERCHANCE_PROD_URL=https://perchance.org/your-prod-generator#edit
PERCHANCE_PROD_COLLAB=your-prod-collab-key
PERCHANCE_DEV_URL=https://perchance.org/your-dev-generator#edit
PERCHANCE_DEV_COLLAB=your-dev-collab-key
PERCHANCE_BUTTONT_URL=https://perchance.org/your-buttont-generator#edit
PERCHANCE_BUTTONT_COLLAB=your-buttont-collab-key
PERCHANCE_NONAME_URL=https://perchance.org/your-noname-generator#edit
PERCHANCE_NONAME_COLLAB=your-noname-collab-key
PERCHANCE_IMAGE_URL=https://perchance.org/your-image-generator#edit
PERCHANCE_IMAGE_COLLAB=your-image-collab-key

# Google & Gemini
GEMINI_API_KEY=your-gemini-api-key
STITCH_API_KEY=your-stitch-api-key
JULES_API_KEY=your-jules-api-key

# Other Integrations & MCP
PLAYWRIGHT_MCP_EXTENSION_TOKEN=your-playwright-token
GITHUB_TOKEN=your-github-pat
HF_TOKEN=your-huggingface-token
CONTEXT7_API_KEY=your-context7-api-key
CODACY_ACCOUNT_TOKEN=your-codacy-token
OPENAI_API_KEY=your-openai-api-key
POLLINATIONS_API_KEY=your-pollinations-api-key
FIRECRAWL_API_KEY=your-firecrawl-api-key
