# .env.example - Template for RPGlitch Engine
# Copy this to .env and fill in the values.

# Smithery
SMITHERY_API_KEY=your-smithery-api-key
SMITHERY_PROFILE=your-smithery-profile

# Developer Database
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
PINECONE_API_KEY=your-pinecone-api-key

# Perchance (Deployment)
PERCHANCE_USERNAME=your-perchance-username
PERCHANCE_KEY=your-perchance-key
PERCHANCE_URL=https://perchance.org/your-project#edit

# Google
STITCH_API_KEY=your-stitch-api-key
JULES_API_KEY=your-jules-api-key

# Other Integrations & MCP
GITHUB_TOKEN=your-github-pat
HF_TOKEN=your-huggingface-token
CONTEXT7_API_KEY=your-context7-api-key
CODACY_ACCOUNT_TOKEN=your-codacy-token
OPENAI_API_KEY=your-openai-api-key
POLLINATIONS_API_KEY=your-pollinations-api-key
FIRECRAWL_API_KEY=your-firecrawl-api-key
