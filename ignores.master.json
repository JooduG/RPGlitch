{
  "antigravityignore": ["!**/*.env", "!**/*.git/**", "!**/*scribbles**", "!**/*scrabbles**", "!**/templates/**", "!**/test-results/**", "!**/tmp/**"],
  "common": [
    "*.bak",
    "*.log",
    "*.template",
    "*.tmp",
    "**/*.lock",
    ".secrets",
    "**/.DS_Store",
    "**/.env*",
    "**/.eslintcache",
    "**/.git/**",
    "**/cache/**",
    "**/.next/**",
    "**/*ignore",
    "**/.turbo/**",
    "**/Thumbs.db",
    "**/__snapshots__/**",
    "**/archive/**",
    "**/build/**",
    "**/bun.lockb",
    "**/coverage/**",
    "**/dist/**",
    "**/mcp.json",
    "**/node_modules/**",
    "**/out/**",
    "**/pnpm-lock.yaml",
    "**/public/assets/**",
    "src/design.css",
    "src/media/design.css",
    "src/media/tokens.js",
    "**/*scribbles**",
    "**/*scrabbles**",
    "**/*scrobbles**",
    "**/templates/**",
    "**/test-results/**",
    "**/yarn.lock",
    "**/tmp/**",
    "**/.prettiercache",
    "**/.stylelintcache"
  ],
  "gitignore": ["!.env.example", "!package-lock.json", "!**/*main.pjs", "!**/templates/**", "act_output.log", "gha-creds-*.json"],
  "jsconfig": {
    "exclude": [
      "**/.agents/**",
      "**/.git/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/coverage/**",
      "**/archive/**",
      "**/tmp/**",
      "test-results/**",
      ".secrets",
      "**/*.lock"
    ]
  },
  "linters": {
    "eslint": [],
    "markdownlint": ["**/modern-web-guidance/guides/**", "**/suggestion*"],
    "prettier": ["**/suggestion*", "package-lock.json", "package.json", "eslint.config.js", ".vscode/settings.json", "jsconfig.json", "vitest.config.js"],
    "stylelint": []
  },
  "vitest": { "exclude": ["**/node_modules/**", "**/dist/**", "**/.git/**", "**/tmp/**", "**/archive/**"] },
  "vscode": {
    "files.exclude": {
      "**/.agents/skills/**/templates": true,
      "**/.DS_Store": true,
      "**/bun.lockb": true,
      "**/node_modules/**": true,
      "**/pnpm-lock.yaml": true,
      "**/src/**/index.js": true,
      "**/Thumbs.db": true,
      "**/yarn.lock": true
    }
  }
}
