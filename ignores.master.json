{
  "antigravityignore": [],
  "common": [
    "*.bak",
    "*.log",
    "*.template",
    "*.tmp",
    "**/*.lock",
    ".secrets",
    "**/.DS_Store",
    "**/.env*",
    "**/.eslintcache",
    "**/.git/**",
    "**/cache/**",
    "**/.next/**",
    "**/*ignore",
    "**/.turbo/**",
    "**/Thumbs.db",
    "**/__snapshots__/**",
    "**/archive/**",
    "**/build/**",
    "**/bun.lockb",
    "**/coverage/**",
    "**/dist/**",
    "**/mcp.json",
    "**/node_modules/**",
    "**/out/**",
    "**/pnpm-lock.yaml",
    "**/public/assets/**",
    "src/data/definitions/signature-colors.js",
    "src/media/design.css",
    "src/media/tokens.js",
    "**/*scribbles**",
    "**/*scrobbles**",
    "**/templates/**",
    "**/test-results/**",
    "**/yarn.lock",
    "**/tmp/**",
    "tmp/**/*"
  ],
  "geminiignore": ["!**/*.env", "!**/*.git/**", "!**/*scribbles**", "!**/templates/**", "!**/test-results/**", "!**/tmp/**", "!tmp/**/*"],
  "gitignore": ["!.env.example", "!package-lock.json", "!**/*rpglitch-left-panel.txt", "!**/templates/**", "act_output.log", "gha-creds-*.json"],
  "linters": {
    "eslint": [],
    "htmlhint": ["**/*.svelte"],
    "markdownlint": ["**/modern-web-guidance/guides/**", "**/suggestion*"],
    "prettier": ["**/suggestion*", "eslint.config.js", ".vscode/settings.json"],
    "stylelint": []
  },
  "vscode": {
    "files.exclude": {
      "**/.DS_Store": true,
      "**/bun.lockb": true,
      "**/node_modules/**": true,
      "**/pnpm-lock.yaml": true,
      "**/Thumbs.db": true,
      "**/yarn.lock": true,
      "**/src/**/index.js": true,
      "**/.gemini/config/skills/**/templates": true,
      "src/data/definitions/signature-colors.js": true,
      "src/media/design.css": true,
      "src/media/tokens.js": true
    }
  },
  "jsconfig": {
    "exclude": [
      "**/.git/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/coverage/**",
      "**/archive/**",
      "**/tmp/**",
      "tmp/**/*",
      "test-results/**",
      ".secrets",
      "**/*.lock"
    ]
  },
  "vitest": {
    "exclude": ["**/node_modules/**", "**/dist/**", "**/.git/**", "**/tmp/**", "**/archive/**"]
  }
}
